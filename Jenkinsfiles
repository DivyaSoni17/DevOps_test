pipeline {
    agent any

    environment {
    APP_NAME = "flask-app"
    PYTHON_VERSION = "3"   // or just remove this variable
    VENV_DIR = "venv"
}

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                credentialsId: 'Jenkinsfiles_test_devops',
                url: 'https://github.com/DivyaSoni17/DevOps_test.git'
            }
        }

        stage('Setup Python Environment') {
            steps {
                echo 'Setting up virtual environment...'
                sh """
                python3 -m venv ${VENV_DIR}
                . ${VENV_DIR}/bin/activate
                pip install --upgrade pip
                pip install flask pytest
                """
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                sh """
                    . ${VENV_DIR}/bin/activate
                    pip install -r requirements.txt
                """
            }
        }

        stage('Lint') {
            steps {
                echo 'Running linter...'
                sh """
                    . ${VENV_DIR}/bin/activate
                    pip install flake8
                    flake8 browser_flask.py --max-line-length=120
                """
            }
        }

    }  // closes stages
}      // closes pipeline  ← THIS WAS MISSING